# ══════════════════════════════════════════════════════════════
# ZORVIAN ERP — Environment Variables Template
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ══════════════════════════════════════════════════════════════

# ── Database ──
ConnectionStrings__ZorvianDb=Host=your-host;Database=your-db;Username=your-user;Password=your-password;SSL Mode=Require

# ── JWT ──
Jwt__Secret=your-jwt-secret-minimum-32-characters-long
Jwt__ExpirationMinutes=60
Jwt__RefreshExpirationDays=7

# ── Firebase ──
Firebase__ProjectId=your-firebase-project-id
Firebase__CredentialsFilePath=path-to-service-account.json
Firebase__WebApiKey=your-firebase-web-api-key
Firebase__StorageBucket=your-firebase-storage-bucket

# ── Encryption ──
Encryption__Key=your-encryption-key-32-chars

# ── CORS ──
Cors__AllowedOrigins__0=https://app.zorvian.com
Cors__AllowedOrigins__1=https://zorvian-web.web.app

# ── Google AI (for Chatbot, OCR, Predictions) ──
GoogleAi__ProjectId=your-google-ai-project-id
GoogleAi__Location=us-central1

# ── Testing ──
Testing__MockExternalServices=false

# ── Features ──
Features__Swagger=false