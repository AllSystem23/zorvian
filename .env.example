# ══════════════════════════════════════════════════════════════
# Zorvian ERP — Local Development Environment Template
# ══════════════════════════════════════════════════════════════
# Copy this file to `.env` at the repo root to override the defaults
# baked into docker-compose.yml:
#
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real secrets.
# All values below are DEVELOPMENT-ONLY placeholders.
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL (local container) ──
POSTGRES_DB=zorvian_erp
POSTGRES_USER=zorvian
POSTGRES_PASSWORD=zorvian_dev_2026

# ── RabbitMQ (local container) ──
RABBITMQ_USER=zorvian
RABBITMQ_PASSWORD=zorvian_dev_2026

# ── Backend secrets ──
# JWT signing key: must be at least 32 characters (HS256).
JWT_SECRET=zorvian-dev-only-jwt-signing-key-do-not-use-in-production-0123456789
# AES-256-GCM key: REQUIRED to be exactly 32 bytes, base64-encoded (44 chars).
ENCRYPTION_KEY=em9ydmlhbi1kZXYtZW5jcnlwdGlvbi1rZXktMzJieSE=

# ── Local bootstrap ──
# Unlocks POST /zorvian/v1/seed/super-admin so you can create the first
# Super Admin locally without Firebase.
ZORVIAN_BOOTSTRAP_KEY=zorvian-dev-bootstrap-key

# ── Firebase (optional for local development) ──
# Firebase Auth is only needed for the Google/Firebase login path.
# Leave FIREBASE_CREDENTIALS_JSON empty to skip Firebase entirely —
# use `POST /zorvian/v1/auth/login-password` for local logins instead.
FIREBASE_PROJECT_ID=zorvian-erp
FIREBASE_CREDENTIALS_JSON=

# ── Frontend ──
# Port on the HOST that serves the Flutter web dev server (<=> container :3000).
# Change this if 3000 is taken by another project.
FRONTEND_PORT=3001

# API base URL resolved by the BROWSER, so `localhost` is correct here
# even though the Flutter dev server runs inside a container.
# ⚠️ If you change FRONTEND_PORT, that origin must also be listed in
#    Cors:AllowedOrigins (see src/Zorvian.Web/appsettings.Development.json).
API_URL=http://localhost:8080/zorvian/v1
